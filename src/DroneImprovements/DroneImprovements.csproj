<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DroneImprovements</AssemblyName>
    <RootNamespace>DroneImprovements</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Optional: in-game settings when Risk of Options is installed (soft dependency, not shipped). -->
    <Reference Include="RiskOfOptions"><HintPath>$(ProfileDir)\BepInEx\plugins\Rune580-Risk_Of_Options\RiskOfOptions\RiskOfOptions.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Icons generated by tools/make_icons.py -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="DroneImprovements.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(DeployToProfile)' == 'true' And Exists('$(ProfileDir)')">
    <MakeDir Directories="$(ProfileDir)\BepInEx\plugins\DroneImprovements" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ProfileDir)\BepInEx\plugins\DroneImprovements" />
  </Target>
</Project>
