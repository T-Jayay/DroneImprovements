<Project Sdk="Microsoft.NET.Sdk">
  <!-- DroneImprovements: improves Remote Operation, the game's feature that lets dead players pilot drones.
       Everything else comes from Directory.Build.props and Directory.Build.targets in the repo root. -->
  <ItemGroup>
    <!-- Skill icons drawn by tools/make_icons.py, embedded as DroneImprovements.Assets.<file name>. -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="$(MSBuildProjectName).Assets.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
